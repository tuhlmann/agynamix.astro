---
import { Image } from "astro:assets";
import logo from "../images/products/invoicer-logo.svg";
import dashboard from "../images/products/invoicer-dashboard.jpg";
import StoryRenderer from "./StoryRenderer";
import { AllowedCategories } from "../utils/prepare-story-data";
import germanStory from "../data/story.de";
import englishStory from "../data/story";
import type { Locale } from "../i18n/types";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const productUrl = (path: string) =>
  `https://invoicer.agynamix.de/${lang === "en" ? "en/" : ""}${path}`;
const content = {
  de: {
    badge: "Desktop-App",
    headline: "Deine Rechnungen.",
    headlineAccent: "Deine Daten.",
    lead: "Rechnungssoftware für Selbstständige und kleine Unternehmen – auf Windows, macOS und Linux.",
    introduction:
      "Dein Unternehmen verdient Software, die zu Dir passt. Schreibe Rechnungen und E-Rechnungen, verwalte Kunden und behalte Zahlungen im Blick – lokal auf Deinem Rechner, ohne verpflichtende Cloud und ohne laufende Lizenzkosten.",
    platformIntroduction:
      "Ob Windows im Büro, macOS im Studio oder Linux am Arbeitsplatz: Du entscheidest, wo Du arbeitest. Deine Geschäftsdaten bleiben unter Deiner Kontrolle.",
    everydayTitle: "Weniger Rechnungsarbeit. Mehr Zeit für Dein Geschäft.",
    everydayDescription:
      "Vom ersten Kunden bis zur nächsten Rechnung: Behalte Deine Abläufe an einem Ort im Blick. Statt Kundendaten und offene Beträge in verschiedenen Tabellen zu suchen, konzentrierst Du Dich auf das, was Dein Unternehmen voranbringt.",
    trialInvitation:
      "Finde in Ruhe heraus, wie Invoicer zu Deinem Arbeitsalltag passt. Teste alle Funktionen 30 Tage lang kostenlos und entscheide danach, welche Lizenz zu Dir passt.",
    trialLink: "30 Tage kostenlos testen",
    websiteLink: "Zur Invoicer-Website",
    trialNote: "Ohne Kreditkarte · Windows, macOS & Linux",
    imageLabel: "Dashboard-Mockup vergrößern",
    imageAlt:
      "AGYNAMIX Invoicer Dashboard auf einem Desktop-Gerät mit Zahlungsübersicht und offenen Rechnungen",
    imageCaption:
      "Dein Geschäft im Blick: Rechnungen, Zahlungseingänge und offene Beträge.",
    enlargeImage: "Ansicht vergrößern ↗",
    platformTitle: "Dein System. Deine Wahl.",
    platformDescription:
      "Windows, macOS oder Linux: Arbeite mit dem Betriebssystem, das zu Dir passt. Invoicer gibt es für alle drei Plattformen.",
    localTitle: "Lokal arbeiten. Unabhängig bleiben.",
    localDescription:
      "Erstelle und verwalte Deine Rechnungen auch ohne Internetverbindung. Im Einzelplatzbetrieb brauchst Du keinen Cloud-Dienst für Deine Geschäftsdaten.",
    ownershipTitle: "Deine Daten gehören Dir.",
    ownershipDescription:
      "Kunden, Rechnungen und Belege bleiben auf Deinem Rechner – im Team auf Deinem eigenen Host. Du bestimmst, wer Zugriff erhält und ob externe Dienste ins Spiel kommen.",
    licenceTitle: "Einmal zahlen. Dauerhaft nutzen.",
    licenceDescription:
      "Kein verpflichtendes Lizenzabo, keine monatlichen Lizenzkosten. Updates sind im ersten Jahr inklusive; danach entscheidest Du über einen optionalen Update-Pass.",
    freedomTitle: "Mehr Freiheit für Deinen Arbeitsalltag.",
    freedomDescription:
      "Deine Rechnungsarbeit soll nicht davon abhängen, ob ein Cloud-Anbieter gerade erreichbar ist oder seine Konditionen ändert. Mit Invoicer nutzt Du Deine zuletzt erhaltene Version dauerhaft weiter. Du behältst Deine Daten und entscheidest selbst, wann Du aktualisierst.",
    privacyTitle: "Datenschutz beginnt beim Speicherort.",
    privacyDescription:
      "Im lokalen Betrieb musst Du Deine Kunden- und Rechnungsdaten keinem Cloud-Anbieter zur Verarbeitung überlassen. Das gibt Dir Klarheit darüber, wo Deine Daten liegen und wer darauf zugreifen kann.",
    featuresTitle: "Mehr als Rechnungen schreiben.",
    featuresDescription:
      "Kundenverwaltung, automatische Rechnungsnummern und Zahlungsübersicht unterstützen Deinen Alltag. Je nach Lizenz kommen Eingangsbelege, E-Mail-Versand und die Zusammenarbeit im Team hinzu.",
    featuresLink: "Alle Funktionen →",
    pricingLink: "Lizenzen & Preise →",
    faqLink: "Häufige Fragen →",
  },
  en: {
    badge: "Desktop app",
    headline: "Your invoices.",
    headlineAccent: "Your data.",
    lead: "Invoicing software for freelancers and small businesses – on Windows, macOS and Linux.",
    introduction:
      "Your business deserves software that fits the way you work. Create invoices and e-invoices, manage customers and keep track of payments – locally on your computer, without a mandatory cloud service or recurring licence fees.",
    platformIntroduction:
      "Windows in the office, macOS in the studio or Linux at your desk: you choose where you work. Your business data stays under your control.",
    everydayTitle: "Less invoice admin. More time for your business.",
    everydayDescription:
      "From your first customer to your next invoice, keep your workflow in one place. Spend less time searching separate spreadsheets for customer details and outstanding amounts, and focus on moving your business forward.",
    trialInvitation:
      "Take your time to see how Invoicer fits your working day. Try every feature free for 30 days, then choose the licence that suits you.",
    trialLink: "Try free for 30 days",
    websiteLink: "Visit the Invoicer website",
    trialNote: "No credit card required · Windows, macOS & Linux",
    imageLabel: "Enlarge dashboard mockup",
    imageAlt:
      "AGYNAMIX Invoicer dashboard on a desktop device showing payments and outstanding invoices",
    imageCaption:
      "Your business at a glance: invoices, incoming payments and outstanding amounts.",
    enlargeImage: "Enlarge image ↗",
    platformTitle: "Your system. Your choice.",
    platformDescription:
      "Windows, macOS or Linux: work with the operating system that suits you. Invoicer is available for all three platforms.",
    localTitle: "Work locally. Stay independent.",
    localDescription:
      "Create and manage invoices even without an internet connection. In standalone mode, your business data needs no cloud service.",
    ownershipTitle: "Your data belongs to you.",
    ownershipDescription:
      "Customers, invoices and documents stay on your computer – or on your own host when working as a team. You decide who gets access and whether to use external services.",
    licenceTitle: "Pay once. Keep using it.",
    licenceDescription:
      "No mandatory licence subscription or monthly licence fees. Updates are included for the first year; after that, you choose whether to purchase an optional Update Pass.",
    freedomTitle: "More freedom in your working day.",
    freedomDescription:
      "Your invoicing should not depend on a cloud provider being available or changing its terms. With Invoicer, you can keep using the last version you received indefinitely. You keep your data and choose when to update.",
    privacyTitle: "Privacy starts with where your data lives.",
    privacyDescription:
      "When working locally, you do not need to hand your customer and invoice data to a cloud provider for processing. You know where your data lives and who can access it.",
    featuresTitle: "More than writing invoices.",
    featuresDescription:
      "Customer management, automatic invoice numbering and payment tracking support your daily work. Depending on your licence, you can also manage incoming documents, send invoices by email and work as a team.",
    featuresLink: "All features →",
    pricingLink: "Licences & pricing →",
    faqLink: "Frequently asked questions →",
  },
};
const copy = content[lang];
const otherProducts = (lang === "de" ? germanStory : englishStory).filter(
  (item) => item.position !== "Invoicer",
);
---

<div class="products-page">
  <header class="page-intro">
    <span class="eyebrow"
      >{
        lang === "de"
          ? "SOFTWARE MIT EIGENER HANDSCHRIFT"
          : "SOFTWARE WITH A PERSONAL TOUCH"
      }</span
    >
    <h1>{lang === "de" ? "Produkte von AGYNAMIX" : "Products by AGYNAMIX"}</h1>
    <p>
      {
        lang === "de"
          ? "Software, die Arbeit einfacher macht. Entwickelt mit Blick auf klare Abläufe und die Kontrolle über die eigenen Daten."
          : "Software that makes work easier. Built around clear workflows and control over your own data."
      }
    </p>
  </header>
  <section
    class="product"
    aria-label="AGYNAMIX Invoicer"
    id="2025-10-01-agynamix"
  >
    <div class="product-intro">
      <div class="brand">
        <img src={logo.src} alt="" width="46" height="47" /><span
          >AGYNAMIX® <strong>Invoicer</strong></span
        ><span class="badge">{copy.badge}</span>
      </div>
      <h2>{copy.headline}<br /><em>{copy.headlineAccent}</em></h2>
      <p class="lead">{copy.lead}</p>
      <p>{copy.introduction}</p>
      <p>{copy.platformIntroduction}</p>
      <h3 class="everyday-title">{copy.everydayTitle}</h3>
      <p>{copy.everydayDescription}</p>
      <p>{copy.trialInvitation}</p>
      <div class="actions">
        <a class="button primary" href={productUrl("download/")}
          >{copy.trialLink} <span aria-hidden="true">↗</span></a
        ><a class="website" href={productUrl("")}
          >{copy.websiteLink} <span aria-hidden="true">↗</span></a
        >
      </div>
      <p class="fine">{copy.trialNote}</p>
    </div>
    <figure class="app-preview">
      <a
        href={dashboard.src}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copy.imageLabel}
        ><Image
          src={dashboard}
          widths={[480, 800, 1200, 1800]}
          sizes="(max-width: 760px) calc(100vw - 86px), (max-width: 1120px) 38vw, 440px"
          alt={copy.imageAlt}
          width={1800}
          height={1197}
        /></a
      >
      <figcaption>
        {copy.imageCaption}
        <span>{copy.enlargeImage}</span>
      </figcaption>
    </figure>
    <div class="benefits">
      <div><h3>{copy.platformTitle}</h3><p>{copy.platformDescription}</p></div>
      <div><h3>{copy.localTitle}</h3><p>{copy.localDescription}</p></div>
      <div>
        <h3>{copy.ownershipTitle}</h3><p>{copy.ownershipDescription}</p>
      </div>
      <div><h3>{copy.licenceTitle}</h3><p>{copy.licenceDescription}</p></div>
    </div>
    <div class="product-details">
      <h3>{copy.freedomTitle}</h3><p>{copy.freedomDescription}</p><p>
        <strong>{copy.privacyTitle}</strong>
        {copy.privacyDescription}
      </p><p>
        <strong>{copy.featuresTitle}</strong>
        {copy.featuresDescription}
      </p><nav
        aria-label={lang === "de"
          ? "Weitere Informationen zu Invoicer"
          : "More about Invoicer"}
      >
        <a href={productUrl("features/")}>{copy.featuresLink}</a><a
          href={productUrl("pricing/")}>{copy.pricingLink}</a
        ><a href={productUrl("faq/")}>{copy.faqLink}</a>
      </nav>
    </div>
  </section>
  <section class="other-products">
    <h2>{lang === "de" ? "Weitere Projekte" : "More projects"}</h2>
    <p>
      {
        lang === "de"
          ? "Neue Ideen und Software aus früheren Jahren."
          : "New ideas and software from earlier years."
      }
    </p>
    <div class="my-prose">
      <StoryRenderer
        story={otherProducts}
        lang={lang}
        withDescription
        categories={[AllowedCategories.Product]}
      />
    </div>
  </section>
</div>
<style>
  .products-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 10px 28px 70px;
    color: #202a35;
  }
  .page-intro {
    margin: 0 0 36px;
    max-width: 740px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #80504d;
  }
  .page-intro h1 {
    font-size: 36px;
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin: 12px 0 14px;
    font-weight: 700;
  }
  .page-intro p {
    font-size: 17px;
    line-height: 1.7;
    color: #66717d;
  }
  .product {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 50px #16233305;
    display: grid;
  }
  .product-intro {
    padding: 40px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    flex-wrap: wrap;
  }
  .brand strong {
    font-weight: 750;
  }
  .badge {
    font-size: 10px;
    background: #f0f3f2;
    border-radius: 5px;
    padding: 3px 7px;
    color: #53645c;
  }
  .product h2 {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 750;
    margin: 30px 0 20px;
  }
  .product h2 em {
    font-style: normal;
    color: #bc514d;
  }
  .product p {
    font-size: 15px;
    line-height: 1.75;
    color: #5d6874;
    margin: 0 0 16px;
  }
  .product .lead {
    font-size: 19px;
    line-height: 1.5;
    color: #263341;
  }
  .everyday-title {
    margin: 28px 0 12px;
    font-size: 19px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .actions {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
    margin: 25px 0 9px;
  }
  .button {
    padding: 12px 16px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    display: inline-flex;
    gap: 18px;
  }
  .primary {
    background: #ba514d;
    color: white;
  }
  .primary:hover {
    background: #9e403d;
  }
  .website {
    font-size: 13px;
    font-weight: 650;
    color: #34414e;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .product .fine {
    font-size: 11px;
    color: #78828a;
  }
  .app-preview {
    margin: 0;
    background: #eef0ef;
    min-width: 0;
  }
  .app-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .app-preview a {
    display: block;
    overflow: hidden;
  }
  .app-preview figcaption {
    font-size: 11px;
    line-height: 1.7;
    padding: 12px 18px;
    color: #687079;
    background: #f7f8f7;
  }
  .app-preview figcaption span {
    display: block;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding: 32px 40px;
    gap: 30px;
    border-top: 1px solid #edf0f2;
  }
  .benefits h3 {
    font-size: 15px;
    line-height: 1.4;
    font-weight: 700;
    margin: 7px 0 9px;
  }
  .benefits p {
    font-size: 13px;
    margin: 0;
  }
  .product-details {
    padding: 26px 40px;
    background: #fafbf9;
    border-top: 1px solid #edf0f2;
  }
  .product-details h3 {
    font-size: 23px;
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 18px;
    letter-spacing: -0.02em;
  }
  .product-details p {
    font-size: 14px;
    max-width: 850px;
  }
  .product-details nav {
    display: flex;
    gap: 27px;
    flex-wrap: wrap;
  }
  .product-details a {
    font-size: 13px;
    font-weight: 650;
    color: #a84b47;
    text-decoration: none;
  }
  .product {
    grid-template-columns: 1.4fr 1fr;
  }
  .product .product-intro {
    grid-row: 1/3;
  }
  .product h2 {
    font-size: 42px;
  }
  .product .app-preview {
    align-self: start;
    margin: 30px 30px 0 0;
    border-radius: 10px;
    overflow: hidden;
  }
  .product .app-preview a {
    height: 235px;
  }
  .product .app-preview img {
    object-fit: contain;
    background: #f1ebe2;
  }
  .product .benefits {
    grid-column: 2;
    grid-template-columns: 1fr;
    border: 0;
    padding: 22px 30px 30px 0;
    gap: 15px;
  }
  .product .benefits h3 {
    margin: 0 0 3px;
  }
  .product .product-details {
    grid-column: 1/-1;
  }

  @media (max-width: 760px) {
    .product {
      grid-template-columns: 1fr;
    }
    .products-page {
      padding: 0 18px 70px;
    }
    .page-intro h1 {
      font-size: 29px;
    }
    .page-intro {
      margin-bottom: 25px;
    }
    .product-intro {
      padding: 25px;
    }
    .product h2 {
      font-size: 39px;
    }
    .benefits {
      grid-template-columns: 1fr;
      padding: 25px;
      gap: 22px;
    }
    .product-details {
      padding: 25px;
    }
    .product-details nav {
      gap: 15px;
    }
    .product .product-intro {
      grid-row: auto;
    }
    .product .app-preview {
      margin: 0 25px;
    }
    .product .benefits {
      grid-column: 1;
      padding: 25px;
    }
    .brand {
      gap: 8px;
      font-size: 14px;
    }
  }

  .other-products {
    margin-top: 50px;
  }
  .other-products > h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .other-products > p {
    color: #73808b;
    margin-bottom: 24px;
  }
  a:focus-visible {
    outline: 3px solid #a84b47;
    outline-offset: 4px;
  }
  .website:hover,
  .product-details a:hover {
    text-decoration: underline;
  }
</style>
